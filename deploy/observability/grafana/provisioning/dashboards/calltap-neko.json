{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }] } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "calltap_calls_active", "refId": "A" }],
      "title": "Active Call",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "OK" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "calltap_pulse_healthy", "refId": "A" }],
      "title": "PulseAudio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "calltap_pending_uploads", "refId": "A" }],
      "title": "Pending Uploads",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 1 }] } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(neko_webrtc_connection_state == 1) or vector(0)", "refId": "A" }],
      "title": "Neko WebRTC Connected",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }, { "color": "green", "value": 1 }] } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "max(neko_capture_pipelines_active{video_id=\"microphone\"}) or vector(0)", "refId": "A" }],
      "title": "Client Mic Active",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 }] }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "refId": "A" }],
      "title": "VM Memory Used %",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "targets": [
        { "expr": "sum(rate(neko_webrtc_bytes_sent[1m]))", "legendFormat": "WebRTC Sent/s", "refId": "A" },
        { "expr": "sum(rate(neko_webrtc_bytes_received[1m]))", "legendFormat": "WebRTC Recv/s", "refId": "B" },
        { "expr": "sum(rate(neko_capture_streamsrc_data_bytes_sum{video_id=\"microphone\"}[1m]))", "legendFormat": "Client Mic Audio/s", "refId": "C" },
        { "expr": "sum(rate(neko_capture_streamsink_bytes{video_id=\"audio\"}[1m]))", "legendFormat": "Browser Audio Out/s", "refId": "D" }
      ],
      "title": "Neko WebRTC & Audio Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "targets": [
        { "expr": "sum(rate(neko_webrtc_transport_layer_nacks[1m]))", "legendFormat": "NACKs/s", "refId": "A" },
        { "expr": "max(neko_webrtc_receiver_report_jitter)", "legendFormat": "Jitter", "refId": "B" },
        { "expr": "sum(rate(neko_webrtc_receiver_report_total_lost[1m]))", "legendFormat": "Lost pkts/s", "refId": "C" }
      ],
      "title": "Neko WebRTC Quality (NACKs / Jitter / Loss)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": {} },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 11 },
      "id": 9,
      "targets": [
        { "expr": "sum by (service) (increase(calltap_calls_started_total[1h]))", "legendFormat": "Started {{service}}", "refId": "A" },
        { "expr": "sum by (status) (increase(calltap_uploads_total[1h]))", "legendFormat": "Uploads {{status}}", "refId": "B" },
        { "expr": "sum by (event) (increase(calltap_browser_events_total[1h]))", "legendFormat": "UI {{event}}", "refId": "C" }
      ],
      "title": "CallTap Calls, Uploads & Browser Events (1h)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 11 },
      "id": 10,
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, path) (rate(calltap_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{path}}", "refId": "A" }
      ],
      "title": "CallTap HTTP p95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 18 },
      "id": 11,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service_name=\"neko\"}", "refId": "A" }],
      "title": "Neko Logs (Loki)",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 18 },
      "id": 12,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showLabels": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true },
      "targets": [{ "expr": "{service_name=\"calltap\"}", "refId": "A" }],
      "title": "CallTap Logs (Loki)",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["calltap", "neko", "gltm"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
