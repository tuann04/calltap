# --- Neko (remote Chrome) ---
NEKO_USER_PASSWORD=change-me-user
NEKO_ADMIN_PASSWORD=change-me-admin
# Portrait works great on a phone (1008x1712 at 2x DPI = 504x856 CSS px); switch to 1280x720@30 or 1920x1080@30 + CHROME_SCALE_FACTOR=1 for desktop
NEKO_DESKTOP_SCREEN=1008x1712@30
CHROME_SCALE_FACTOR=2
NEKO_SESSION_IMPLICIT_HOSTING=true
# For VPS without Tailscale, set this to your public IP and expose UDP 52000:
NEKO_WEBRTC_NAT1TO1=
NEKO_WEBRTC_UDPMUX=52000
# Optional Cloudflare Access OIDC SSO for Neko (set on deployed VM .env; keep defaults for local password login)
# NEKO_MEMBER_PROVIDER=oauth
# NEKO_SESSION_COOKIE_ENABLED=true
# NEKO_OAUTH_ENABLED=true
# NEKO_OAUTH_AUTO_REDIRECT=true
# NEKO_OAUTH_CLIENT_ID=
# NEKO_OAUTH_CLIENT_SECRET=
# NEKO_OAUTH_ISSUER_URL=
# NEKO_OAUTH_REDIRECT_URL=
# NEKO_OAUTH_ADMIN_EMAILS=
# NEKO_OAUTH_USER_EMAILS=

# --- CallTap ---
CALLTAP_DATA_DIR=/data
CALLTAP_RECORDINGS_DIR=/data/calls
CALLTAP_DB_PATH=/data/calltap.db
CALLTAP_PULSE_SERVER=unix:/var/run/pulse/pulseaudio.socket
CALLTAP_USER_SOURCE=audio_input.monitor
CALLTAP_AGENT_SOURCE=audio_output.monitor
CALLTAP_SAMPLE_RATE=48000
CALLTAP_CREATE_STEREO_MIX=true
CALLTAP_STOP_GRACE_SECONDS=2.5
CALLTAP_SILENCE_STOP_SECONDS=20
CALLTAP_SILENCE_THRESHOLD_DB=-55
CALLTAP_NEKO_METRICS_URL=http://neko:8080/metrics
CALLTAP_NEKO_DISCONNECT_STOP_SECONDS=10
CALLTAP_AUTO_DETECT=true
CALLTAP_DEFAULT_SERVICE=unknown

# Optional Chrome DevTools Protocol endpoint for page metadata / login check
CALLTAP_CDP_URL=http://neko:9222

# --- Cloud Upload (rclone) ---
# Example: "r2:calltap-bucket" or "s3:my-bucket/calltap" or "gcs:my-bucket/calltap" or "b2:my-bucket/calltap"
# Leave empty to disable automatic cloud upload (recordings still stay in /data/calls).
CALLTAP_RCLONE_REMOTE=
CALLTAP_RCLONE_CONFIG=/config/rclone/rclone.conf
# Delete local audio files N days after verified cloud upload (0 = keep forever)
CALLTAP_LOCAL_RETENTION_DAYS=7

# Optional push notification on completed upload (e.g. https://ntfy.sh/your-secret-topic)
CALLTAP_NTFY_URL=

# Optional basic auth username/password for the CallTap dashboard (recommended if exposed beyond Tailscale)
CALLTAP_DASHBOARD_USER=
CALLTAP_DASHBOARD_PASS=

# Optional Cloudflare Access JWT verification (allows passkey SSO via Cloudflare Access without Basic Auth)
CALLTAP_CF_ACCESS_TEAM=
CALLTAP_CF_ACCESS_AUD=
CALLTAP_CF_ACCESS_ALLOWED_EMAILS=

# --- Observability (GLTM Stack: Grafana + Loki + Tempo + Mimir + Alloy) ---
CALLTAP_LOG_JSON=true
CALLTAP_OTLP_ENDPOINT=http://alloy:4318/v1/traces
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=calltap-grafana
