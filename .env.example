# --- Neko (remote Chrome) ---
NEKO_USER_PASSWORD=change-me-user
NEKO_ADMIN_PASSWORD=change-me-admin
# Portrait works great on a phone; switch to 1280x720@30 or 1920x1080@30 for desktop
NEKO_DESKTOP_SCREEN=800x1600@30
# For VPS without Tailscale, set this to your public IP and expose UDP 52000:
NEKO_WEBRTC_NAT1TO1=
NEKO_WEBRTC_UDPMUX=52000

# --- CallTap ---
CALLTAP_DATA_DIR=/data
CALLTAP_RECORDINGS_DIR=/data/calls
CALLTAP_DB_PATH=/data/calltap.db
CALLTAP_PULSE_SERVER=unix:/var/run/pulse/pulseaudio.socket
CALLTAP_USER_SOURCE=audio_input.monitor
CALLTAP_AGENT_SOURCE=audio_output.monitor
CALLTAP_SAMPLE_RATE=48000
CALLTAP_CREATE_STEREO_MIX=true
CALLTAP_STOP_GRACE_SECONDS=2.5
CALLTAP_AUTO_DETECT=true
CALLTAP_DEFAULT_SERVICE=sesame

# Optional Chrome DevTools Protocol endpoint for page metadata / login check
CALLTAP_CDP_URL=http://neko:9222

# --- Cloud Upload (rclone) ---
# Example: "r2:calltap-bucket" or "s3:my-bucket/calltap" or "gcs:my-bucket/calltap" or "b2:my-bucket/calltap"
# Leave empty to disable automatic cloud upload (recordings still stay in /data/calls).
CALLTAP_RCLONE_REMOTE=
CALLTAP_RCLONE_CONFIG=/config/rclone/rclone.conf
# Delete local audio files N days after verified cloud upload (0 = keep forever)
CALLTAP_LOCAL_RETENTION_DAYS=7

# Optional push notification on completed upload (e.g. https://ntfy.sh/your-secret-topic)
CALLTAP_NTFY_URL=

# Optional basic auth username/password for the CallTap dashboard (recommended if exposed beyond Tailscale)
CALLTAP_DASHBOARD_USER=
CALLTAP_DASHBOARD_PASS=
